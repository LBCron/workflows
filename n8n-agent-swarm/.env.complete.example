# ============================================
# BOT PAUL & MANAGER BOT - CONFIGURATION COMPLÈTE
# ============================================

# ===== TELEGRAM BOTS =====
TELEGRAM_BOT_TOKEN=YOUR_PAUL_BOT_TOKEN_HERE
MANAGER_BOT_TOKEN=YOUR_MANAGER_BOT_TOKEN_HERE
MANAGER_ADMIN_USER_ID=7949081795

# ===== OPENAI (GPT-4o-mini recommandé) =====
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_MODEL=gpt-4o-mini

# ===== GMAIL OAUTH =====
GMAIL_CLIENT_ID=xxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxx
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback
GMAIL_REFRESH_TOKEN=1//0gxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_USER=your-email@gmail.com

# ===== GOOGLE CALENDAR OAUTH =====
GOOGLE_CALENDAR_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_CALENDAR_REFRESH_TOKEN=1//0gxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CALENDAR_ID=primary

# ===== GOOGLE DRIVE OAUTH =====
GOOGLE_DRIVE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_DRIVE_REFRESH_TOKEN=1//0gxxxxxxxxxxxxxxxxxxxxxxx

# ===== WEB SEARCH (Optionnel) =====
SEARCH_ENGINE=duckduckgo
# Si vous voulez utiliser SerpAPI (payant mais meilleur):
# SEARCH_ENGINE=serpapi
# SERPAPI_KEY=your_serpapi_key_here

# ===== MEMORY & STORAGE =====
MEMORY_LOCAL_PATH=./data
MEMORY_BACKUP_PATH=./backups
MEMORY_EXPORT_PATH=./exports
MEMORY_ENCRYPTION_KEY=your-secret-key-must-be-at-least-32-characters-long

# ===== BUDGET GUARDIAN =====
MONTHLY_BUDGET_LIMIT=20.0
BUDGET_WARNING_THRESHOLD=0.75
BUDGET_CRITICAL_THRESHOLD=0.90

# ===== XIANYU PLATFORMS (Optionnel) =====
XIANYU_COOKIES=...
WECHAT_TOKEN=...
WEIGOU_API_KEY=...

# ===== ADVANCED AI MODELS (Optionnel - pour multi-model routing) =====
# Si DEFAULT_MODEL est défini, ces clés ne sont pas nécessaires

# Groq (Llama 3 GRATUIT)
# GROQ_API_KEY=gsk_xxxxx

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# Google (Gemini)
# GOOGLE_API_KEY=AIzaSyxxxxx

# ===== N8N (Si utilisé) =====
# N8N_URL=http://localhost:5678
# N8N_API_KEY=xxxxx
