# AI Agent Swarm - Telegram Bot - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# 🚀 QUICK START - Minimal Configuration
# ============================================
# Pour démarrer rapidement, remplis JUSTE ces 3 variables:

# 1. Token Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# 2. OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-...

# 3. Budget mensuel max (EUR)
MONTHLY_BUDGET_LIMIT=20

# C'EST TOUT! Le bot fonctionnera avec GPT-4 Mini (€0.08-0.15/mois)
# Pour activer les autres modèles, voir "Advanced AI Models" ci-dessous.

# ============================================
# AI Model Configuration (Intelligent Router)
# ============================================

# DEFAULT_MODEL: Force a single model for all AI requests (RECOMMENDED)
# When set, bypasses intelligent multi-model routing and always uses this model.
# This simplifies configuration and significantly reduces costs.
#
# Recommended setting for personal use (simple mode):
# DEFAULT_MODEL=gpt-4o-mini

# 🚀 MODE SOPHISTIQUÉ - Multi-Model Intelligent Routing
# Pour activer le routing intelligent avec 7 modèles AI différents:
# 1. COMMENTE la ligne ci-dessus (DEFAULT_MODEL)
# 2. Configure les clés API dans "Advanced AI Models" ci-dessous
# 3. Le router choisira automatiquement le meilleur modèle pour chaque tâche!
#
# Avantages:
# - Llama 3 GRATUIT pour questions simples (70% des requêtes)
# - GPT-4 Mini pour contenu medium (20%)
# - Claude Opus pour code/recherche expert (10%)
# - Coût: €5-10/mois au lieu de €30-50 avec juste GPT-4
DEFAULT_MODEL=gpt-4o-mini
#
# Why gpt-4o-mini?
# - Ultra-cheap: €0.00015/1K input tokens (100x cheaper than GPT-4)
# - Excellent quality: 92/100 performance (vs GPT-4's 95/100)
# - Great for code, analysis, content creation
# - With 70% cache hit rate: ~€0.08-0.15/month total cost
#
# Other available models (if you comment out DEFAULT_MODEL):
# - gpt-4-turbo        Premium quality, €0.01/1K
# - claude-3-haiku     Fast & cheap, €0.00025/1K
# - claude-3-sonnet    Balanced, €0.003/1K
# - claude-3-opus      Best quality, €0.015/1K
# - llama-3-70b        Free via Groq
# - gemini-flash       Ultra-cheap, €0.0001/1K
#
# Advanced: Leave empty for intelligent multi-model routing
# (requires multiple API keys, higher complexity)
# DEFAULT_MODEL=

# Monthly AI budget limit in EUR (default: 20)
# Budget Guardian will alert you at 75%, 90%, 95% and block at 95%
MONTHLY_BUDGET_LIMIT=20

# ============================================
# n8n Configuration
# ============================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
N8N_USER=admin
N8N_PASSWORD=changeme_strong_password_here
N8N_LOG_LEVEL=info
N8N_SECURE_COOKIE=false

# Webhook URL (change to your domain in production)
WEBHOOK_URL=http://localhost:5678

# Timezone
TIMEZONE=Europe/Paris

# Execution settings
EXECUTIONS_TIMEOUT=300
EXECUTIONS_TIMEOUT_MAX=600

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changeme_postgres_password_here
POSTGRES_DB=n8n

# ============================================
# Telegram Bot Configuration
# ============================================
# Get your bot token from @BotFather on Telegram
# Tutorial: https://core.telegram.org/bots#6-botfather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ============================================
# OpenRouter API (for GPT-4 access)
# ============================================
# Sign up at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your_key_here

# ============================================
# Advanced AI Models (Optional - for Multi-Model Router)
# ============================================
# Si tu veux activer l'intelligent router multi-modèles,
# commente DEFAULT_MODEL ci-dessus et ajoute ces clés:

# OpenAI API (déjà configuré ci-dessus)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key_here

# Anthropic API (for Claude models)
# Get your key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Groq API (for Llama 3 - FREE!)
# Get your key at: https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# Google AI (for Gemini models)
# Get your key at: https://makersuite.google.com/app/apikey
# GOOGLE_API_KEY=AIzaSy...

# ============================================
# 📧📅 Email & Calendar Agents Configuration
# ============================================
# Ces agents nécessitent OAuth2 configuration
# Tutoriel complet: run `npm run setup:gmail` or `npm run setup:calendar`

# === GMAIL AGENT (Email Pro) ===
# 1. Créer OAuth credentials: https://console.cloud.google.com/apis/credentials
# 2. Activer Gmail API: https://console.cloud.google.com/apis/library/gmail.googleapis.com
# 3. Configurer OAuth consent screen
# 4. Run: npm run setup:gmail (pour obtenir le refresh token)

GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback
GMAIL_REFRESH_TOKEN=

# === GOOGLE CALENDAR AGENT (Calendar Pro) ===
# 1. Même OAuth credentials que Gmail (ou créer séparés)
# 2. Activer Calendar API: https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
# 3. Run: npm run setup:calendar (pour obtenir le refresh token)

GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_REFRESH_TOKEN=

# === OUTLOOK/HOTMAIL AGENT (Email Pro) ===
# 1. Register app: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# 2. Add Microsoft Graph permissions: Mail.Read, Mail.Send
# 3. Get access token via OAuth flow

# OUTLOOK_CLIENT_ID=your_outlook_app_id
# OUTLOOK_CLIENT_SECRET=your_outlook_secret
# OUTLOOK_ACCESS_TOKEN=

# ============================================
# Google Services (legacy - for other features)
# ============================================
# Google Sheet ID for logging
# Get from sheet URL: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ============================================
# YouTube API
# ============================================
# Create at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# ============================================
# Web Search APIs
# ============================================

# Tavily Search API
# Sign up at: https://tavily.com/#api
TAVILY_API_KEY=tvly-your_key_here

# Perplexity AI API
# Get key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-your_key_here

# ============================================
# Weather API
# ============================================
# Get free key at: https://home.openweathermap.org/api_keys
OPENWEATHERMAP_API_KEY=your_openweathermap_key_here

# ============================================
# Optional: Notion Integration
# ============================================
# Get integration token at: https://www.notion.so/my-integrations
# NOTION_API_KEY=secret_your_notion_key_here
# NOTION_DATABASE_ID=your_database_id_here

# ============================================
# Deployment Configuration (for CI/CD)
# ============================================
# For automated deployment via GitHub Actions
# N8N_INSTANCE_URL=https://your-n8n-instance.com
# N8N_API_KEY=your_api_key_for_deployment

# ============================================
# Automated Agent Creation (GitHub Actions)
# ============================================
# For automated agent creation from Telegram
# See AUTOMATION.md for setup guide

# GitHub Personal Access Token (with repo + workflow scopes)
# Get from: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Repository (format: owner/repo)
GITHUB_REPOSITORY=LBCron/workflows

# Telegram Chat ID (for automation notifications)
# Get by sending a message to your bot and checking:
# https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_CHAT_ID=123456789

# Fly.io API Token (for auto-deploy)
# Get from: fly auth token
# FLY_API_TOKEN=fo1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Advanced Configuration
# ============================================

# Enable AI features
N8N_AI_ENABLED=true

# Execution data retention (days)
# EXECUTIONS_DATA_PRUNE_MAX_AGE=168

# Number of concurrent executions
# N8N_CONCURRENCY_PRODUCTION_LIMIT=10

# Enable metrics (for monitoring)
# N8N_METRICS=true
# N8N_METRICS_PREFIX=n8n_

# ============================================
# Security Notes
# ============================================
# 1. Never commit this file with real credentials
# 2. Use strong, unique passwords
# 3. Rotate API keys regularly
# 4. In production, use secrets management (Vault, AWS Secrets Manager, etc.)
# 5. Enable HTTPS in production
# 6. Use environment-specific .env files (.env.prod, .env.staging)

# ============================================
# 🔐 Universal Credential Vault
# ============================================
# Secure credential management for all services
# Supports: Email, Commerce, Social Media, Payment, Custom services

# Master password for credential encryption (REQUIRED - use strong password!)
# This encrypts all credentials in the vault
MASTER_PASSWORD=change_this_to_a_strong_password_min_16_chars

# Vault salt (optional - leave as default or change for extra security)
# VAULT_SALT=your_custom_salt_here

# Vault automatically supports 30+ services:
# - Email: Gmail, Outlook, Yahoo, ProtonMail, iCloud, Custom SMTP
# - Commerce: Xianyu, Weigou, Vinted, Taobao, AliExpress, eBay, Leboncoin
# - Productivity: Google, Microsoft365, Notion, Trello, Slack
# - Social: WeChat, WhatsApp, Twitter, LinkedIn
# - Payment: PayPal, Stripe, Alipay, WeChat Pay
# - Custom: Any service with custom credentials
#
# To add a service, use Telegram commands:
# /credentials - View configured services
# /add_service - Add new service credentials
# /list_services - List all supported services

# ============================================
# Quick Start Checklist
# ============================================
# ✅ 1. Copy this file to .env
# ✅ 2. Fill in Telegram Bot Token
# ✅ 3. Fill in OpenRouter API Key
# ✅ 4. Fill in OpenAI API Key
# ✅ 5. Set MASTER_PASSWORD for credential vault
# ✅ 6. Configure Google OAuth
# ✅ 7. Create Google Sheet and add ID
# ✅ 8. (Optional) Add other API keys
# ✅ 9. Run: docker-compose up -d
# ✅ 10. Open http://localhost:5678
# ✅ 11. Import workflow and configure credentials in n8n UI
