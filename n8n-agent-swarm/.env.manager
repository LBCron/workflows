# ============================================
# MANAGER BOT - Commerce Chine-France
# ============================================

# ===== TELEGRAM BOT =====
MANAGER_BOT_TOKEN=123456:ABC-DEF1234ghIJKlmNOPQRstuVWXYZ

# ===== ADMIN =====
MANAGER_ADMIN_USER_ID=7949081795

# ===== OPENAI (pour traduction seulement) =====
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_MODEL=gpt-4o-mini

# ===== XIANYU SCRAPER =====
# Python path (pour Playwright)
PYTHON_PATH=/usr/bin/python3
# Path to ai-goofish-monitor
XIANYU_MONITOR_PATH=/path/to/ai-goofish-monitor
# Cookies (si login manuel)
XIANYU_COOKIES=

# ===== CONVERSION RATE =====
CNY_TO_EUR_RATE=0.13

# ===== VINTED API =====
# (Gratuit - pas de clé nécessaire)
VINTED_BASE_URL=https://www.vinted.fr

# ===== PLATFORMS (Optionnel) =====
WECHAT_TOKEN=
WEIGOU_API_KEY=

# ===== MEMORY & STORAGE =====
MEMORY_LOCAL_PATH=./data/manager-bot
MEMORY_BACKUP_PATH=./backups/manager-bot
MEMORY_EXPORT_PATH=./exports/manager-bot
MEMORY_ENCRYPTION_KEY=your-secret-key-must-be-at-least-32-characters-long

# ===== BUDGET (Optionnel) =====
MONTHLY_BUDGET_LIMIT=10.0
BUDGET_WARNING_THRESHOLD=0.75
BUDGET_CRITICAL_THRESHOLD=0.90

# ============================================
# NOTES D'UTILISATION:
# ============================================
#
# 1. SETUP INITIAL:
#    - Remplace MANAGER_BOT_TOKEN par ton token Manager Bot
#    - Remplace OPENAI_API_KEY par ta clé OpenAI (pour traduction)
#
# 2. POUR XIANYU SCRAPING:
#    - Installe Python 3.8+
#    - Installe Playwright: pip install playwright
#    - Installe browsers: python -m playwright install chromium
#    - Clone ai-goofish-monitor:
#      git clone https://github.com/xxxx/ai-goofish-monitor
#    - Configure XIANYU_MONITOR_PATH avec le chemin
#
# 3. LANCER MANAGER BOT:
#    - npm run manager
#    ou
#    - node src/bots/telegram/manager-bot.js
#
# 4. COMMANDES TELEGRAM:
#    - /start - Menu principal
#    - /xianyu_login - Login Xianyu (QR code)
#    - /xianyu_scan [ID] [pages] - Scanner vendeur
#    - /xianyu_status - Vérifier statut
#    - /deals - Voir deals trouvés
#    - /vendors - Gérer vendeurs
#    - /stats - Statistiques
#
# 5. WORKFLOW TYPIQUE:
#    a. /xianyu_login → Scanne QR code
#    b. /xianyu_scan ABC123 50 → Scanne vendeur (50 pages max)
#    c. Attendre 10-15 minutes...
#    d. /deals → Voir les deals rentables
#
# 6. COÛTS:
#    - Xianyu scraping: €0 (pas d'AI, juste scraping)
#    - Vinted API: €0 (gratuit)
#    - OpenAI (traduction): ~€0.001 par produit
#
# ============================================
