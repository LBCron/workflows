{
  "name": "n8n-agent-swarm",
  "version": "1.0.0",
  "description": "Multi-agent AI automation system powered by n8n with specialized agents for email, calendar, contacts, YouTube, and web operations",
  "main": "index.js",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "start": "docker-compose up -d && sleep 10 && npm run auto-import",
    "start:windows": "scripts\\start-n8n.bat",
    "start:dev": "docker-compose up",
    "stop": "docker-compose down",
    "logs": "docker-compose logs -f n8n",
    "restart": "docker-compose restart n8n",
    "import-workflow": "node scripts/import-workflow.js",
    "auto-import": "bash scripts/auto-import.sh",
    "auto-import:windows": "powershell -ExecutionPolicy Bypass -File scripts\\auto-import.ps1",
    "configure": "node scripts/configure-credentials.js",
    "validate": "node scripts/validate-workflow.js",
    "deploy": "node scripts/deploy-workflow.js",
    "test": "node scripts/run-all-tests.js",
    "test:unit": "node scripts/run-all-tests.js unit",
    "test:integration": "node scripts/run-all-tests.js integration",
    "test:e2e": "node scripts/run-all-tests.js e2e",
    "test:performance": "node scripts/run-all-tests.js performance",
    "backup": "bash scripts/backup.sh",
    "clean": "docker-compose down -v && rm -rf logs/*",
    "generate-agent": "node scripts/generate-agent.js",
    "add-meta": "node scripts/add-meta-agent.js",
    "quick-import": "bash scripts/quick-import.sh",
    "learn": "node scripts/learning-system.js",
    "optimize": "node scripts/optimize-prompts.js",
    "analyze": "echo 'Analytics dashboard - implement scripts/analytics-dashboard.js'",
    "feedback": "echo 'Feedback loop - implement scripts/feedback-loop.js'",
    "storage:init": "node scripts/phone-storage/init-storage.js",
    "storage:sync": "node scripts/phone-storage/telegram-file-handler.js sync",
    "storage:status": "node scripts/phone-storage/telegram-file-handler.js status",
    "storage:backup": "node scripts/phone-storage/telegram-file-handler.js backup",
    "storage:clear": "node scripts/phone-storage/telegram-file-handler.js clear",
    "postinstall": "echo '✅ Setup complete! Run: npm start (Linux/Mac) or npm run start:windows (Windows)'",
    "prod": "NODE_ENV=production docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d"
  },
  "keywords": [
    "n8n",
    "automation",
    "ai-agents",
    "multi-agent",
    "workflow",
    "telegram-bot",
    "langchain",
    "gpt-4",
    "openai",
    "google-apis"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/n8n-agent-swarm.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/n8n-agent-swarm/issues"
  },
  "homepage": "https://github.com/yourusername/n8n-agent-swarm#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "prettier": "^3.0.3"
  },
  "dependencies": {},
  "optionalDependencies": {},
  "peerDependencies": {},
  "config": {
    "n8n_version": "latest",
    "postgres_version": "15-alpine"
  }
}
