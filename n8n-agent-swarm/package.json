{
  "name": "ai-agent-swarm",
  "version": "4.0.0",
  "description": "Complete AI Agent Swarm - Telegram bot with 12 specialized agents (Research, Content, Code, Email, Calendar, Meta, Social Media, Data, Voice, Image, Translation, Document), intelligent multi-model routing, semantic cache, and budget protection. Professional architecture with src/, comprehensive tests, and full documentation.",
  "main": "src/bot/index.js",
  "scripts": {
    "start": "node src/bot/index.js",
    "start:legacy": "node scripts/telegram-bot.js",
    "dev": "NODE_ENV=development nodemon src/bot/index.js",
    "dev:legacy": "NODE_ENV=development node scripts/telegram-bot.js",
    "prestart": "node scripts/validate-env.js",
    "validate": "node scripts/validate-env.js",
    "api": "node scripts/api-server.js",
    "test": "node scripts/run-all-tests.js",
    "test:core": "node scripts/test-core-agents.js",
    "test:bugs": "node scripts/bug-detector.js",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "audit": "node scripts/run-full-audit.js",
    "simulate": "node scripts/test-complete-system.js",
    "lint": "eslint src/**/*.js scripts/**/*.js",
    "lint:fix": "eslint src/**/*.js scripts/**/*.js --fix",
    "lint:src": "eslint src/**/*.js",
    "optimize": "node scripts/analyze-optimizations-v2.js",
    "structure": "node scripts/analyze-structure.js",
    "migrate": "node scripts/migration/restructure.js",
    "setup:gmail": "node scripts/setup/setup-gmail-oauth.js",
    "setup:calendar": "node scripts/setup/setup-calendar-oauth.js"
  },
  "keywords": [
    "telegram-bot",
    "ai-agents",
    "multi-model-ai",
    "intelligent-routing",
    "semantic-cache",
    "budget-guardian",
    "gpt-4",
    "claude",
    "llama",
    "openai",
    "anthropic"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/n8n-agent-swarm.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/n8n-agent-swarm/issues"
  },
  "homepage": "https://github.com/yourusername/n8n-agent-swarm#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "prettier": "^3.0.3"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "form-data": "^4.0.0",
    "node-telegram-bot-api": "^0.64.0",
    "openai": "^4.20.0",
    "@anthropic-ai/sdk": "^0.9.1",
    "@google/generative-ai": "^0.1.3",
    "groq-sdk": "^0.3.2",
    "express": "^4.18.2",
    "googleapis": "^128.0.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "nodemailer": "^6.9.7",
    "node-cron": "^3.0.3"
  },
  "optionalDependencies": {},
  "peerDependencies": {},
  "config": {
    "n8n_version": "latest",
    "postgres_version": "15-alpine"
  }
}
