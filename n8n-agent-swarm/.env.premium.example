# ===================================
# AI AGENT SWARM - PREMIUM EDITION
# Configuration File
# ===================================

# ===================================
# BOT TOKENS
# ===================================

# Paul Bot (Main user-facing bot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Manager Bot (Admin/Monitoring bot)
MANAGER_BOT_TOKEN=your_manager_bot_token_here

# ===================================
# SECURITY
# ===================================

# Master password for encryption (AES-256-GCM)
# REQUIRED for Credential Vault
# Use a strong, unique password
MASTER_PASSWORD=your_master_password_here

# Admin Chat IDs (comma-separated)
# Users who can access Manager Bot
ADMIN_CHAT_IDS=123456789,987654321

# ===================================
# GOOGLE SERVICES (Optional)
# ===================================

# Gmail & Google Calendar OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ===================================
# MICROSOFT SERVICES (Optional)
# ===================================

# Outlook OAuth
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# ===================================
# AI PROVIDERS
# ===================================

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google AI (Gemini)
GOOGLE_AI_API_KEY=your_google_ai_api_key

# Groq
GROQ_API_KEY=your_groq_api_key

# ===================================
# SYSTEM CONFIGURATION
# ===================================

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Node environment
NODE_ENV=production

# ===================================
# PREMIUM FEATURES CONFIG (Optional)
# ===================================

# Auto-export iPhone sync interval (minutes)
IPHONE_SYNC_INTERVAL=1440

# Cache TTL (seconds)
CACHE_TTL_L1=300
CACHE_TTL_L2=3600
CACHE_TTL_L3=86400

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=500

# Security
INTRUSION_DETECTION_ENABLED=true
AUTO_BAN_ENABLED=true
FAILED_LOGIN_THRESHOLD=5

# Performance monitoring
PERFORMANCE_ALERTS_ENABLED=true
AUTO_REPORTING_ENABLED=true
AUTO_REPORT_INTERVAL=3600000

# ===================================
# NOTES
# ===================================

# 1. MASTER_PASSWORD is REQUIRED for the system to start
# 2. For Google/Microsoft services, you need to set up OAuth apps
# 3. Admin chat IDs can be found by messaging your bot and checking logs
# 4. Keep this file secure and NEVER commit it to git
# 5. Use strong, unique passwords
