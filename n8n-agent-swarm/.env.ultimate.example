# 🚀 ULTIMATE AI SYSTEM - Environment Configuration
# Copy this to .env and fill in your values

# ===== TELEGRAM BOT =====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_user_id

# ===== OPENAI API =====
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000

# ===== ANTHROPIC API (Claude) =====
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ===== GOOGLE AI (Gemini) =====
GOOGLE_API_KEY=your_google_ai_api_key_here
GOOGLE_MODEL=gemini-pro

# ===== GROQ API (Fast inference) =====
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=mixtral-8x7b-32768

# ===== 🔐 CREDENTIAL VAULT =====
# Master password for encrypting credentials (min 32 chars)
MASTER_PASSWORD=your_super_secure_master_password_at_least_32_characters_long!!!
VAULT_SALT=your_random_salt_32_chars_here

# ===== 📱 IPHONE SYNC & BACKUP =====
# Encryption key for backups (32 chars)
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_32_chars_here!
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 3 * * *"  # 3 AM daily

# ===== ⚡ CACHE CONFIGURATION =====
CACHE_MAX_MEMORY_MB=100
CACHE_MAX_DISK_GB=1
CACHE_DEFAULT_TTL_SECONDS=3600
CACHE_EVICTION_STRATEGY=LRU  # LRU, LFU, FIFO
CACHE_COMPRESSION_ENABLED=true
CACHE_PERSISTENT_ENABLED=true

# ===== 📊 MONITORING SYSTEM =====
MONITORING_ENABLED=true
MONITORING_INTERVAL_SECONDS=10
ALERT_RESPONSE_TIME_MS=5000
ALERT_ERROR_RATE_PERCENT=5
ALERT_CPU_PERCENT=80
ALERT_MEMORY_PERCENT=80
ALERT_COST_PER_HOUR_USD=10

# ===== 🧠 LEARNING ENGINE =====
LEARNING_ENABLED=true
LEARNING_MIN_CONVERSATIONS=10
LEARNING_CONTEXT_WINDOW=20
LEARNING_ADAPTATION_THRESHOLD=0.7
LEARNING_CONSOLIDATION_HOUR=4  # 4 AM

# ===== 🛍️ COMMERCE INTEGRATIONS =====

# Xianyu (闲鱼)
XIANYU_PHONE=+86XXXXXXXXXX
XIANYU_PASSWORD=your_xianyu_password
XIANYU_SCAN_INTERVAL_MINUTES=5

# Vinted
VINTED_EMAIL=your_email@example.com
VINTED_PASSWORD=your_vinted_password

# Taobao (淘宝)
TAOBAO_USERNAME=your_taobao_username
TAOBAO_PASSWORD=your_taobao_password

# eBay
EBAY_USERNAME=your_ebay_username
EBAY_PASSWORD=your_ebay_password
EBAY_API_KEY=your_ebay_api_key
EBAY_API_SECRET=your_ebay_api_secret

# ===== 📧 EMAIL SERVICES =====

# Gmail
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Outlook/Hotmail
OUTLOOK_EMAIL=your_email@outlook.com
OUTLOOK_PASSWORD=your_outlook_password

# Yahoo
YAHOO_EMAIL=your_email@yahoo.com
YAHOO_APP_PASSWORD=your_yahoo_app_password

# iCloud
ICLOUD_EMAIL=your_email@icloud.com
ICLOUD_APP_PASSWORD=your_icloud_app_password

# ===== 📊 GOOGLE WORKSPACE =====
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# ===== 💼 MICROSOFT 365 =====
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=your_tenant_id
MICROSOFT_REFRESH_TOKEN=your_microsoft_refresh_token

# ===== 📝 PRODUCTIVITY TOOLS =====

# Notion
NOTION_API_KEY=your_notion_integration_token

# Trello
TRELLO_API_KEY=your_trello_api_key
TRELLO_API_TOKEN=your_trello_token

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_WORKSPACE_ID=your_workspace_id

# ===== 💬 SOCIAL MEDIA =====

# WeChat (微信)
WECHAT_PHONE=+86XXXXXXXXXX
WECHAT_PASSWORD=your_wechat_password

# WhatsApp
WHATSAPP_PHONE=+1XXXXXXXXXX

# Twitter/X
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret

# ===== 💳 PAYMENT SERVICES =====

# Stripe
STRIPE_API_KEY=your_stripe_api_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Alipay (支付宝)
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_alipay_private_key

# ===== 🔧 ADVANCED SETTINGS =====
NODE_ENV=production
LOG_LEVEL=info
PORT=3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000  # 1 minute
RATE_LIMIT_MAX_REQUESTS=100

# Budget Guardian
MAX_COST_PER_DAY_USD=50
MAX_COST_PER_MONTH_USD=1000
BUDGET_ALERT_THRESHOLD_PERCENT=80

# Session
SESSION_SECRET=your_random_session_secret_here
SESSION_MAX_AGE_HOURS=24

# Database
DATABASE_PATH=./data/bot.db
DATABASE_BACKUP_ENABLED=true

# Logging
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/bot.log
LOG_MAX_SIZE_MB=100
LOG_MAX_FILES=10

# ===== 🚀 PERFORMANCE =====
ENABLE_COMPRESSION=true
ENABLE_CACHING=true
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT_MS=30000

# ===== 🔒 SECURITY =====
ENABLE_HELMET=true
ENABLE_CORS=true
ALLOWED_ORIGINS=*
ENABLE_2FA=false
IP_WHITELIST=
USER_WHITELIST=

# ===== 🎨 UI/UX =====
ENABLE_RICH_UI=true
ENABLE_QUICK_ACTIONS=true
ENABLE_INLINE_KEYBOARDS=true
ENABLE_PROGRESS_BARS=true

# ===== 🤖 AI BEHAVIOR =====
ENABLE_PROACTIVE_SUGGESTIONS=true
ENABLE_RESPONSE_ADAPTATION=true
ENABLE_INTENT_PREDICTION=true
CONTEXT_MEMORY_SIZE=20

# ===== 📱 FEATURES =====
ENABLE_VOICE=false
ENABLE_IMAGE_ANALYSIS=true
ENABLE_DOCUMENT_PROCESSING=true
ENABLE_CODE_EXECUTION=false
ENABLE_WEB_SEARCH=true
