
# ============================================
# 🚀 v4.0 - New System Configuration
# ============================================

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Node Environment (development, production, test)
NODE_ENV=development

# ============================================
# 🎯 QUICK START GUIDE v4.0
# ============================================
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Fill in REQUIRED variables:
#    - TELEGRAM_BOT_TOKEN (from @BotFather)
#    - OPENAI_API_KEY (from platform.openai.com)
#
# 3. Validate configuration:
#    npm run validate
#
# 4. Start the bot:
#    npm start
#
# 5. Test in Telegram:
#    Send any message to your bot!
#
# 6. Check stats:
#    /stats in Telegram
#    or npm run optimize
#
# ============================================
# 📚 Documentation
# ============================================
# - Architecture: ARCHITECTURE-V4.md
# - Optimizations: OPTIMIZATIONS.md
# - Refactoring: REFACTORING-PLAN.md
# - Setup Gmail: Run npm run setup:gmail
# - Setup Calendar: Run npm run setup:calendar
#
# Questions? Check docs/ folder!

# ============================================
# 🔑 API KEYS - REQUIRED
# ============================================

# Telegram Bot Token (REQUIRED)
# Get from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API Key (REQUIRED)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# 📧 EMAIL AGENT - OPTIONAL
# ============================================

# Gmail OAuth (preferred method)
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
GMAIL_USER=your_email@gmail.com

# Outlook/Office365 (alternative)
OUTLOOK_USER=your_email@outlook.com
OUTLOOK_PASSWORD=your_outlook_password

# ============================================
# 📅 CALENDAR AGENT - OPTIONAL
# ============================================

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

# ============================================
# 💰 BUDGET & COSTS
# ============================================

# Monthly budget limit in USD
BUDGET_LIMIT=10.00

# Budget warning threshold (percentage)
BUDGET_WARNING_THRESHOLD=80

# Budget critical threshold (percentage)
BUDGET_CRITICAL_THRESHOLD=95

# ============================================
# 🤖 MULTI-MODEL AI (OPTIONAL)
# ============================================

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_key

# Google (Gemini)
GOOGLE_AI_API_KEY=your_google_ai_key

# Groq (Fast inference)
GROQ_API_KEY=your_groq_key

# Together AI
TOGETHER_API_KEY=your_together_key

# Mistral
MISTRAL_API_KEY=your_mistral_key

# ============================================
# 🔒 SECURITY (OPTIONAL)
# ============================================

# Encryption key (32 chars)
ENCRYPTION_KEY=your_32_character_encryption_key

# Allowed user IDs (comma separated)
ALLOWED_USERS=

# Rate limit per user (requests per minute)
RATE_LIMIT=10

# ============================================
# 📱 SOCIAL MEDIA (OPTIONAL)
# ============================================

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Twitter/X
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Instagram
INSTAGRAM_ACCESS_TOKEN=

# ============================================
# 🎨 ADVANCED FEATURES (OPTIONAL)
# ============================================

# Default model for routing
DEFAULT_MODEL=gpt-4

# Enable semantic cache
ENABLE_CACHE=true

# Enable budget guardian
ENABLE_BUDGET_GUARDIAN=true

# Enable security features
ENABLE_SECURITY=true

# Logging file path
LOG_FILE_PATH=./logs/app.log

# ============================================
# 🧪 TESTING & DEVELOPMENT
# ============================================

# Test mode (skips API calls)
TEST_MODE=false

# Mock responses
MOCK_RESPONSES=false

# Debug mode
DEBUG=false
